<Project>
  <PropertyGroup>
    <!-- net10.0 tek hedef (ADR-0019). -->
    <TargetFrameworks Condition=" '$(TargetFrameworks)' == '' ">net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- CA1716: breaking change (public interface/type renaming) — intentional suppression -->
    <!-- CA1000: public generic factory methods (Result<T>, Paginate<T>, ApiResponse<T>) — intentional design, suppressed at source -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1716;CA1000</WarningsNotAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Release tags are v1.2.3; without the prefix MinVer ignores them and non-release builds get 0.0.0
         (releases always pass MinVerVersionOverride, so they are unaffected). -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- ImageSharp 4 license: the package only searches the project folder, so use a repo-root sixlabors.lic
       (git-ignored) when present. CI passes the key via the SixLaborsLicenseKey env var instead. -->
  <PropertyGroup Condition=" '$(SixLaborsLicenseKey)' == '' and '$(SixLaborsLicenseFile)' == '' and Exists('$(MSBuildThisFileDirectory)sixlabors.lic') ">
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <!-- Source Link & Deterministic Build (LS-FAZ-1, Bolum 6.1) -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)'=='true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- NuGet Package Metadata                                                 -->
  <!-- Global defaults — overridden per-project via <Description>, <Title>   -->
  <!-- and <PackageTags> in each .csproj                                      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <!-- Identity -->
    <Authors>Ömer Küçük</Authors>
    <Company>Omerkck</Company>
    <Copyright>Copyright © 2026 Ömer Küçük (omerkck41)</Copyright>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- URLs -->
    <PackageProjectUrl>https://github.com/omerkck41/OmerkckArchitecture</PackageProjectUrl>
    <RepositoryUrl>https://github.com/omerkck41/OmerkckArchitecture</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Content -->
    <!--
      PackageReadmeFile: each project can override with its own README.nuget.md.
      When a project-local README.nuget.md does not exist, root README.md is used
      (added via ItemGroup below). Override per-project:
        <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <PackageReleaseNotes>Changelog: https://github.com/omerkck41/OmerkckArchitecture/blob/main/CHANGELOG.md | Releases: https://github.com/omerkck41/OmerkckArchitecture/releases</PackageReleaseNotes>

    <!-- Default description — overridden in every individual .csproj -->
    <Description>Kck Modular Architecture Framework — a modular, extensible .NET 10 framework providing production-ready abstractions and providers for caching, persistence, messaging, security, observability, and more.</Description>

    <!-- Default tags — extended per project -->
    <PackageTags>dotnet;dotnet10;kck;framework;modular;clean-architecture;ddd;net10</PackageTags>
  </PropertyGroup>

  <!-- Package validation: `dotnet pack` fails on a binary breaking change against the last released version
       (CP0002 etc.). Only src/ projects are published, so tests/samples never try to download a baseline.
       Intentional breaks (v4.0) go into a per-project CompatibilitySuppressions.xml; bump the baseline after
       each release. See docs/plans/2026-10-26-dis-inceleme-yol-haritasi.md H7. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/'))">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>4.3.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Icon included in every publishable package -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    README strategy:
      1. If the project has a local README.nuget.md → use it (set PackageReadmeFile per .csproj)
      2. Otherwise → include root README.md as fallback
    Projects with README.nuget.md must set:
      <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    and exclude themselves from the root-README fallback via Condition.
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' AND '$(PackageReadmeFile)' == 'README.md'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false' AND '$(PackageReadmeFile)' == 'README.nuget.md'">
    <None Include="$(MSBuildProjectDirectory)\README.nuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
