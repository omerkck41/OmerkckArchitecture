<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pinned to net10.0; depends on AspNetCore-referencing packages (LS-FAZ-7 §1.1) -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Title>Kck Minimal API Bundle</Title>
    <Description>Lightweight ASP.NET Core Minimal API starter pack. Slim variant of the WebAPI bundle — provides Serilog, in-memory caching, JWT, exception handling, and health checks without MediatR pipeline or Argon2 overhead.</Description>
    <PackageTags>dotnet;kck;minimal-api;aspnetcore;bundle;lightweight;serilog</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup Label="Core Abstractions">
    <ProjectReference Include="../../Abstractions/Kck.Core.Abstractions/Kck.Core.Abstractions.csproj" />
    <ProjectReference Include="../../Abstractions/Kck.Caching.Abstractions/Kck.Caching.Abstractions.csproj" />
    <ProjectReference Include="../../Abstractions/Kck.Security.Abstractions/Kck.Security.Abstractions.csproj" />
    <ProjectReference Include="../../Abstractions/Kck.Observability.Abstractions/Kck.Observability.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Label="Default Providers">
    <ProjectReference Include="../../Providers/Kck.Logging.Serilog/Kck.Logging.Serilog.csproj" />
    <ProjectReference Include="../../Providers/Kck.Caching.InMemory/Kck.Caching.InMemory.csproj" />
    <ProjectReference Include="../../Providers/Kck.Security.Jwt/Kck.Security.Jwt.csproj" />
    <ProjectReference Include="../../Providers/Kck.Exceptions.AspNetCore/Kck.Exceptions.AspNetCore.csproj" />
    <ProjectReference Include="../../Providers/Kck.Observability.OpenTelemetry/Kck.Observability.OpenTelemetry.csproj" />
  </ItemGroup>
</Project>
