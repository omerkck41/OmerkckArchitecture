<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- E4: CS1591 docs complete — enforce XML doc requirement as error for this package. -->
    <NoWarn>$(NoWarn.Replace(';1591','').Replace('1591;','').Replace('1591',''))</NoWarn>
    <Title>Kck Event Bus Abstractions</Title>
    <Description>Provider-agnostic event-driven messaging contracts. Defines IEventBus (Publish/Subscribe), IEventHandler&lt;TEvent&gt;, IntegrationEvent base record, and KckEventBusBuilder for handler registration. Implement with InMemory, RabbitMQ, or Azure Service Bus providers.</Description>
    <PackageTags>dotnet;kck;event-bus;integration-events;pub-sub;messaging;abstractions</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
