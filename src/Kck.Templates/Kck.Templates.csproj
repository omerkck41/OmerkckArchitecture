<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Kck.Templates</PackageId>
    <Title>Kck Project Templates</Title>
    <Description>dotnet new templates for Kck-based .NET projects. kck-webapi: WebAPI with Kck.Bundle.WebApi (Mediator, caching, JWT, Argon2, Serilog, OpenTelemetry, rate limiting).</Description>
    <PackageTags>dotnet;template;kck;webapi;clean-architecture</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- NU5128: no lib/ expected. NU5118: duplicate README. NU5017: content-only pack. -->
    <NoWarn>$(NoWarn);NU5128;NU5118</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU5017;NU5128;NU5118</WarningsNotAsErrors>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="templates/**/*.cs" />
    <Content Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
