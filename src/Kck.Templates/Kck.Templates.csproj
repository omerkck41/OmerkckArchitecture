<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Kck.Templates</PackageId>
    <Title>Kck Project Templates</Title>
    <Description>dotnet new templates for Kck-based .NET projects. Install with 'dotnet new install Kck.Templates' then scaffold with 'dotnet new kck-webapi -n MyApp'. Includes kck-webapi template pre-wired with Kck.Bundle.WebApi.</Description>
    <PackageTags>dotnet;kck;templates;dotnet-new;scaffolding;webapi</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep build output: the stub assembly in lib/ satisfies NuGet's NU5017 content check. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5118</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude template source files from compilation — they are content only. -->
    <Compile Remove="content/**/*.cs" />
    <!--
      Explicit PackagePath to avoid double content/ prefix.
      Files at src/content/Kck.WebApi/... → package at content/Kck.WebApi/...
    -->
    <Content Include="content/**/*"
             Exclude="content/**/bin/**;content/**/obj/**"
             Pack="true"
             PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
