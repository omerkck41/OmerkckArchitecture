<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Holds the JWT signing key created by `dotnet user-jwts` and, for PostgreSQL / SQL Server, the connection string. -->
    <UserSecretsId>8e5a1c2b-3d4f-4a6b-9c7d-0e1f2a3b4c5d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions are stamped when Kck.Templates is packed; they match the Kck release this template ships with. -->
    <PackageReference Include="Kck.Bundle.WebApi" Version="KCK_PACKAGE_VERSION" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="KCK_VERSION(Microsoft.AspNetCore.Authentication.JwtBearer)" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="KCK_VERSION(Microsoft.AspNetCore.OpenApi)" />
    <PackageReference Include="Scalar.AspNetCore" Version="KCK_VERSION(Scalar.AspNetCore)" />
<!--#if (UseSqlite) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="KCK_VERSION(Microsoft.EntityFrameworkCore.Sqlite)" />
<!--#elif (UsePostgres) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="KCK_VERSION(Npgsql.EntityFrameworkCore.PostgreSQL)" />
<!--#else -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="KCK_VERSION(Microsoft.EntityFrameworkCore.SqlServer)" />
    <!-- Lifts the transitive System.Security.Cryptography.Pkcs above versions with known vulnerabilities
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Remove once Microsoft.Data.SqlClient depends on a fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="KCK_VERSION(System.Security.Cryptography.Pkcs)" />
<!--#endif -->
  </ItemGroup>

</Project>
