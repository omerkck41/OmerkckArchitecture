{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kck": {
    "Security": {
      "Jwt": {
        "Issuer": null,
        "Audience": null,
        "Algorithm": "RS256"
      },
      "Hashing": "Argon2"
    },
    "Caching": {
      "Provider": "InMemory"
    },
    "Observability": {
      "Tracing": true,
      "Metrics": true,
      "ServiceName": "KckWebApiTemplate"
    },
    "AspNetCore": {
      "RateLimitPermitLimit": 100,
      "RateLimitWindowSeconds": 60,
      "SecurityHeaders": true,
      "CorsOrigins": []
    }
  }
}
