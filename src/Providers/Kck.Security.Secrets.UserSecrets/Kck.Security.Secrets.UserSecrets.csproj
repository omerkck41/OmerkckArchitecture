<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Secrets (User Secrets)</Title>
    <Description>IConfiguration-backed ISecretsManager for local development. Reads secrets from .NET User Secrets or environment variables without any cloud dependency. Suitable for development and CI environments. Registered via AddKckUserSecrets().</Description>
    <PackageTags>dotnet;kck;security;secrets;user-secrets;development;configuration</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Security.Abstractions/Kck.Security.Abstractions.csproj" />
  </ItemGroup>
</Project>
