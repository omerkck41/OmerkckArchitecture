<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Secrets (Azure Key Vault)</Title>
    <Description>Azure Key Vault-backed ISecretsManager for secure secret retrieval. Supports DefaultAzureCredential (Managed Identity, developer credentials). Retrieves and deserializes typed secrets by name with optional prefix filtering. Registered via AddKckAzureKeyVault().</Description>
    <PackageTags>dotnet;kck;security;secrets;azure;key-vault;managed-identity</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Security.Abstractions/Kck.Security.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
