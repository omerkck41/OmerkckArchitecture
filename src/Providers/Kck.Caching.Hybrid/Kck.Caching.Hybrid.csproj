<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck HybridCache Provider</Title>
    <Description>Two-tier ICacheService implementation backed by Microsoft.Extensions.Caching.Hybrid. Combines L1 in-process memory (fast) and L2 Redis (distributed) caching. SetAsync writes to both layers; RemoveAsync evicts from both. Registered via AddKckCachingHybrid().</Description>
    <PackageTags>dotnet;kck;caching;hybrid-cache;redis;distributed-cache;net10</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kck.Caching.Hybrid.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\Kck.Caching.Abstractions\Kck.Caching.Abstractions.csproj" />
  </ItemGroup>
</Project>
