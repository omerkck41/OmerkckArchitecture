<Project>
  <!--
    TEMPORARY, time-boxed NuGet audit suppression — Kck.Documents.ImageSharp and its tests only.

    SixLabors.ImageSharp 3.1.12 is affected by the advisories below; the only patched line is 4.1.2+.
    ImageSharp 4 requires a Six Labors license key for Release builds (Community license applied for,
    2026-10-14). Until the key is available in CI, the provider stays on 3.1.12 so the rest of the
    security fixes are not blocked. The vulnerability is NOT hidden: it is recorded in
    decisions/2026-10-14-sdk-10.0.402-imagesharp-4.md and in the package README.

    Remove this file (and its two imports) when upgrading to ImageSharp >= 4.1.2. Review by 2026-11-14.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>
