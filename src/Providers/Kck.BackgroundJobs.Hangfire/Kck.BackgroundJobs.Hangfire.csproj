<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Background Jobs (Hangfire)</Title>
    <Description>Hangfire-backed IJobScheduler implementation for the Kck framework. Supports fire-and-forget, recurring (cron), and delayed job scheduling with the Hangfire dashboard. Registered via AddKckJob&lt;TJob&gt;().</Description>
    <PackageTags>dotnet;kck;hangfire;background-jobs;cron;job-scheduler</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.BackgroundJobs.Abstractions/Kck.BackgroundJobs.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hangfire" />
    <PackageReference Include="Hangfire.InMemory" />
    <!-- Overrides Hangfire's transitive Newtonsoft.Json 11.0.1 (GHSA-5crp-9r3c-p9vr). -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
