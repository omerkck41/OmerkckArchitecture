<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pinned to net10.0; depends on net10-only packages (LS-FAZ-2 ADR-0011) -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Title>Kck Persistence (Entity Framework Core)</Title>
    <Description>Entity Framework Core implementations of IReadRepository&lt;T,TId&gt;, IWriteRepository&lt;T,TId&gt;, and IUnitOfWork. Includes AuditInterceptor (auto CreatedDate/ModifiedDate), DynamicFilterExtensions, soft-delete support, and ToPaginateAsync extension. Registered via AddKckEntityFramework&lt;TContext&gt;().</Description>
    <PackageTags>dotnet;kck;persistence;entity-framework;ef-core;repository;unit-of-work</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Core.Abstractions/Kck.Core.Abstractions.csproj" />
    <ProjectReference Include="../../Abstractions/Kck.Persistence.Abstractions/Kck.Persistence.Abstractions.csproj" />
  </ItemGroup>

  <!-- ADR-0031: the analyzers (KCK1001, KCK1002) ship inside this package, under analyzers/dotnet/cs. The reference
       only orders the build; the assembly is not referenced by this library. -->
  <ItemGroup>
    <ProjectReference Include="../../Analyzers/Kck.Persistence.EntityFramework.Analyzers/Kck.Persistence.EntityFramework.Analyzers.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../Analyzers/Kck.Persistence.EntityFramework.Analyzers/bin/$(Configuration)/netstandard2.0/Kck.Persistence.EntityFramework.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>
</Project>
