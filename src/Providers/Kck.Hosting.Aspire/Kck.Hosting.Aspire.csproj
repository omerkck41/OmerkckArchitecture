<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pinned to net10.0; Aspire service discovery targets net10.0 only (LS-FAZ-9) -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Title>Kck .NET Aspire Integration</Title>
    <Description>.NET Aspire host integration for Kck applications. Adds Aspire service discovery (also for HttpClient) and health check services via AddKckServiceDefaults().</Description>
    <PackageTags>dotnet;kck;aspire;hosting;cloud-native;service-defaults</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
  </ItemGroup>
</Project>
