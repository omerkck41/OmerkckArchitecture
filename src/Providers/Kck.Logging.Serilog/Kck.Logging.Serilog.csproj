<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Kck Logging (Serilog)</Title>
    <Description>Serilog structured logging integration for Kck applications. Configures compact JSON console output, PII masking enricher, and ASP.NET Core request logging. Registered via AddKckSerilog() / UseSerilog().</Description>
    <PackageTags>dotnet;kck;logging;serilog;structured-logging;pii-masking</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

</Project>
