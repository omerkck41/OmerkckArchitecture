<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Email (SendGrid)</Title>
    <Description>Twilio SendGrid-backed IEmailProvider for transactional email. Supports HTML/plain-text bodies, attachments, and multiple recipients via SendGrid's v3 Mail API. Registered via AddKckMessagingSendGrid().</Description>
    <PackageTags>dotnet;kck;email;sendgrid;transactional-email;twilio</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Messaging.Abstractions/Kck.Messaging.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SendGrid" />
  </ItemGroup>
</Project>
