<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pinned to net10.0; depends on net10-only packages (LS-FAZ-2 ADR-0011) -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Title>Kck HTTP Resilience Client</Title>
    <Description>Polly-backed IApiClient implementation using Microsoft.Extensions.Resilience. Supports named resilience pipelines with retry, circuit breaker, and timeout strategies. Registered via AddKckHttpClient&lt;TClient&gt;().</Description>
    <PackageTags>dotnet;kck;httpclient;resilience;polly;retry;circuit-breaker</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Http.Abstractions/Kck.Http.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>
</Project>
