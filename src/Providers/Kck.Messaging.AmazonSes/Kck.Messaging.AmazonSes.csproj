<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Email (Amazon SES)</Title>
    <Description>Amazon Simple Email Service v2-backed IEmailProvider. Supports explicit AWS credentials or IAM role authentication with SES v2 BulkEmail API for high-volume sending. Registered via AddKckMessagingAmazonSes().</Description>
    <PackageTags>dotnet;kck;email;amazon;ses;aws;transactional-email</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Messaging.Abstractions/Kck.Messaging.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleEmailV2" />
  </ItemGroup>
</Project>
