<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck File Storage (FTP)</Title>
    <Description>FluentFTP-backed IFileStorageService with connection pooling (FtpConnectionPool). Supports SSL/TLS and configurable pool size for high-throughput scenarios. Path sanitization prevents directory traversal. Registered via AddKckFileStorageFluentFtp().</Description>
    <PackageTags>dotnet;kck;file-storage;ftp;ftps;fluentftp;connection-pool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kck.FileStorage.FluentFtp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.FileStorage.Abstractions/Kck.FileStorage.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentFTP" />
  </ItemGroup>
</Project>
