<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck In-Memory Cache Provider</Title>
    <Description>IMemoryCache-backed ICacheService implementation with key tracking and stampede-safe GetOrSetAsync (64-stripe locking). Suitable for single-instance deployments. Registered via AddKckCachingInMemory().</Description>
    <PackageTags>dotnet;kck;caching;in-memory;memory-cache</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Caching.Abstractions/Kck.Caching.Abstractions.csproj" />
  </ItemGroup>
</Project>
