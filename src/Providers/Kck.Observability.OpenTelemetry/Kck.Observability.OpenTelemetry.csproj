<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- OpenTelemetry.Instrumentation.EntityFrameworkCore has no stable release yet; suppress NU5104 -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <Title>Kck Observability (OpenTelemetry)</Title>
    <Description>OpenTelemetry-backed ITracingService and IMetricsService implementations. Exports traces and metrics via OTLP protocol, wires ASP.NET Core and EF Core auto-instrumentation, and registers Kck health checks at /health. Registered via AddKckObservability().</Description>
    <PackageTags>dotnet;kck;observability;opentelemetry;tracing;metrics;otlp;health-checks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kck.Observability.OpenTelemetry.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Observability.Abstractions/Kck.Observability.Abstractions.csproj" />
  </ItemGroup>

</Project>
