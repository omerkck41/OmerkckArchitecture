<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Search (Elasticsearch)</Title>
    <Description>Elastic.Clients.Elasticsearch 9.x-backed ISearchService&lt;T&gt; for full-text search. Supports index lifecycle (create/delete/exists), document CRUD, bulk indexing, and query operations. Requires Elasticsearch 9.x server. Registered via AddKckSearchElasticsearch&lt;T&gt;().</Description>
    <PackageTags>dotnet;kck;search;elasticsearch;full-text-search;elastic</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Search.Abstractions/Kck.Search.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
  </ItemGroup>
</Project>
