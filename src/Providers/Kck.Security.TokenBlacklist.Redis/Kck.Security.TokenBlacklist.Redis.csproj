<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Token Blacklist (Redis)</Title>
    <Description>Redis-backed ITokenBlacklistService for JWT revocation. Stores blacklisted token identifiers in Redis with automatic TTL expiration. Enables immediate token invalidation on logout or security events. Registered via AddKckTokenBlacklistRedis().</Description>
    <PackageTags>dotnet;kck;security;jwt;token-blacklist;redis;revocation</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.Security.Abstractions/Kck.Security.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
</Project>
