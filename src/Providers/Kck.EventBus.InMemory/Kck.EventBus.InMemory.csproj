<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Native AOT: verified by samples/Kck.AotSmoke (CI publishes and runs it). -->
    <IsAotCompatible>true</IsAotCompatible>
    <Title>Kck In-Memory Event Bus</Title>
    <Description>In-process IEventBus implementation for development and testing. Dispatches integration events synchronously within the same process. Not suitable for distributed scenarios. Registered via builder.UseInMemory().</Description>
    <PackageTags>dotnet;kck;event-bus;in-memory;testing;development</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.EventBus.Abstractions/Kck.EventBus.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
