<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Background Jobs (Quartz.NET)</Title>
    <Description>Quartz.NET-backed IJobScheduler implementation for the Kck framework. Provides fire-and-forget, delayed and cron-based job scheduling on Quartz.NET 4. Registered via AddKckBackgroundJobsQuartz(); jobs via AddKckJob&lt;TJob&gt;().</Description>
    <PackageTags>dotnet;kck;quartz;background-jobs;cron;job-scheduler</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.BackgroundJobs.Abstractions/Kck.BackgroundJobs.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Quartz" />
  </ItemGroup>
</Project>
