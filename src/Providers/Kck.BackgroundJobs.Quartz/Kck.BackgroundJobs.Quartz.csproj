<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Kck Background Jobs (Quartz.NET)</Title>
    <Description>Quartz.NET-backed IJobScheduler implementation for the Kck framework. Provides cron-based and one-shot job scheduling with Quartz's persistent job store support. Registered via AddKckJob&lt;TJob&gt;().</Description>
    <PackageTags>dotnet;kck;quartz;background-jobs;cron;job-scheduler</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Abstractions/Kck.BackgroundJobs.Abstractions/Kck.BackgroundJobs.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
  </ItemGroup>
</Project>
