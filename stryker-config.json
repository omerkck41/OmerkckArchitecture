{
  "stryker-config": {
    "project-info": {
      "name": "Kck Modular Architecture",
      "module": "core"
    },
    "mutation-level": "Standard",
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 60
    },
    "project": "src/Abstractions/Kck.Core.Abstractions/Kck.Core.Abstractions.csproj",
    "test-projects": [
      "tests/Kck.Core.Abstractions.Tests/Kck.Core.Abstractions.Tests.csproj"
    ],
    "reporters": ["html", "progress", "cleartext"],
    "output": "mutation-report/core",
    "since": {
      "enabled": false
    },
    "ignore-mutations": ["string", "logical"]
  }
}
