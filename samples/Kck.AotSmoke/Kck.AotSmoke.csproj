<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Native AOT smoke test (F3 H22): CI publishes this app with PublishAot and runs it. Every provider marked
    IsAotCompatible is referenced and exercised here; a trim/AOT warning fails the publish (warnings are errors).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The RID is set here, not with `dotnet publish -r`: -r would also restore every referenced project for that RID
         and break their lock files (NU1004). The lock file covers both RIDs, so restore is the same on either OS. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="!$([MSBuild]::IsOSPlatform('Windows'))">linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Providers/Kck.Pipeline.Mediator/Kck.Pipeline.Mediator.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.Caching.InMemory/Kck.Caching.InMemory.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.EventBus.InMemory/Kck.EventBus.InMemory.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.FeatureFlags.InMemory/Kck.FeatureFlags.InMemory.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.Security.Argon2/Kck.Security.Argon2.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.Security.Totp/Kck.Security.Totp.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.Security.Jwt/Kck.Security.Jwt.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.Localization/Kck.Localization.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.Localization.Json/Kck.Localization.Json.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.Resilience.Polly/Kck.Resilience.Polly.csproj" />
    <ProjectReference Include="../../src/Providers/Kck.Logging.Serilog/Kck.Logging.Serilog.csproj" />
  </ItemGroup>
</Project>
